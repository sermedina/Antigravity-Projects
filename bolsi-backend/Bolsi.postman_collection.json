              "raw": "{{base_url}}/api/investments/{{investment_id}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["api", "investments", "{{investment_id}}", "transactions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"CONTRIBUTION\",\n  \"amount\": 250.00\n}"
            }
          },
          "response": []
        },
        {
          "name": "04 - Retorno de Inversión (seed)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/investments/{{investment_id}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["api", "investments", "{{investment_id}}", "transactions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"RETURN\",\n  \"amount\": 80.00\n}"
            }
          },
          "response": []
        },
        {
          "name": "05 - Retiro de Inversión (seed)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/investments/{{investment_id}}/transactions",
              "host": ["{{base_url}}"],
              "path": ["api", "investments", "{{investment_id}}", "transactions"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"WITHDRAWAL\",\n  \"amount\": 100.00\n}"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "🎯 Metas",
      "item": [
        {
          "name": "01 - Listar Metas",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/goals", "host": ["{{base_url}}"], "path": ["api", "goals"] }
          },
          "response": []
        },
        {
          "name": "02 - Crear Meta",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "url": { "raw": "{{base_url}}/api/goals", "host": ["{{base_url}}"], "path": ["api", "goals"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop nueva\",\n  \"description\": \"MacBook Pro M4\",\n  \"target_amount\": 2500.00,\n  \"deadline\": \"2026-11-01\"\n}"
            }
          },
